{
  "name": "smart-day-planner-newtech",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["client", "server"],
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "dev": "concurrently -k -n api,client \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "db:init": "npm run db:init -w server",
    "db:migrate": "npm run db:migrate -w server",
    "db:check": "npm run db:check -w server",
    "test": "npm run test -w server && npm run test -w client",
    "test:integration": "npm run test:integration -w server"
  },
  "devDependencies": { "concurrently": "^9.2.1" },
  "overrides": { "express-mysql-session": { "mysql2": "^3.24.6" } }
}
